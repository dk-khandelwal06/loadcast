# LoadCast Environment Configuration
# Node Environment
NODE_ENV=development

# Optional Gemini API Key for extended natural language explanations (server-side only)
# GEMINI_API_KEY=your_gemini_api_key_here

# App URL (default: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate Limiting (Requests per minute per IP for public API endpoints)
RATE_LIMIT_PER_MINUTE=60

